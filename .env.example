# --- Django -----------------------------------------------------------------
DJANGO_SETTINGS_MODULE=aethos.settings.prod
DJANGO_SECRET_KEY=            # long random string
ALLOWED_HOSTS=your-project.vercel.app
DATABASE_URL=                 # Neon POOLED connection string (host contains "-pooler"), with sslmode=require
APP_BASE_URL=https://your-project.vercel.app
FRONTEND_URL=https://your-project.vercel.app

# --- GitHub App ---------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_SLUG=aethos        # the slug GitHub gives your app; @mentions use this
GITHUB_APP_PRIVATE_KEY=       # PEM contents, or the base64 of the PEM file
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Upstash QStash ------------------------------------------------------------
QUEUE_MODE=qstash
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Review model (NVIDIA NIM, uses NVIDIA_API_KEY below) -------------------------
REVIEW_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_MAX_OUTPUT_TOKENS=3000
LLM_TIMEOUT_SECONDS=120

# --- Embeddings (NVIDIA NIM) ----------------------------------------------------
# Get a key at https://build.nvidia.com. Used to embed code chunks while indexing.
NVIDIA_API_KEY=
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
EMBED_MIN_SIMILARITY=0.6
