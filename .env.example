# --- Django -----------------------------------------------------------------
DJANGO_SETTINGS_MODULE=aethos.settings.prod
DJANGO_SECRET_KEY=            # long random string
ALLOWED_HOSTS=your-project.vercel.app
DATABASE_URL=                 # Neon POOLED connection string (host contains "-pooler"), with sslmode=require
APP_BASE_URL=https://your-project.vercel.app
FRONTEND_URL=https://your-project.vercel.app

# --- GitHub App ---------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_SLUG=aethos        # the slug GitHub gives your app; @mentions use this
GITHUB_APP_PRIVATE_KEY=       # PEM contents, or the base64 of the PEM file
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Upstash QStash ------------------------------------------------------------
QUEUE_MODE=qstash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Groq ----------------------------------------------------------------------
GROQ_API_KEY=
REVIEW_MODEL=llama-3.3-70b-versatile
LLM_MAX_OUTPUT_TOKENS=3000
LLM_TIMEOUT_SECONDS=45

# Embeddings need no keys: the GitHub Action indexer runs BAAI bge-base-en-v1.5 itself.
EMBED_MIN_SIMILARITY=0.6

# --- Indexer (GitHub Actions OIDC) ---------------------------------------------
INDEX_OIDC_AUDIENCE=https://your-project.vercel.app   # must equal APP_BASE_URL unless overridden in the Action

# Where the indexing GitHub Action lives, shown to users: <owner>/<repo>/<path>
INDEXER_ACTION_REPO=your-github-user/aethos/action
